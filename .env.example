# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres — use the POOLED connection string ("-pooler" in the host).
DATABASE_URL=

# Cloudflare R2 — credentials are server/script only, never exposed to the browser.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Public base URL the browser loads audio from, with no trailing slash.
# Currently the r2.dev development subdomain (https://pub-<hash>.r2.dev).
# Swapping this for a Cloudflare custom domain later requires no code change,
# because the database stores object keys and URLs are composed server-side.
R2_PUBLIC_URL=

# Kill switch for the song-management API under /api/admin. Leave unset (or
# anything other than "true") and every one of those routes answers 404.
#
# THIS IS NOT AUTHENTICATION. There is no login in this project yet, so while
# the flag is "true" anyone who can reach the origin can create, edit and
# delete songs and obtain write access to the R2 bucket. Set it only for local
# development, and put a real identity check in front of the routes — see the
# header of src/lib/api/admin.ts — before enabling it anywhere deployed.
ADMIN_API_ENABLED=
