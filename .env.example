# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres — use the POOLED connection string ("-pooler" in the host).
DATABASE_URL=

# Cloudflare R2 — credentials are server/script only, never exposed to the browser.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Public base URL the browser loads audio from, with no trailing slash.
# Currently the r2.dev development subdomain (https://pub-<hash>.r2.dev).
# Swapping this for a Cloudflare custom domain later requires no code change,
# because the database stores object keys and URLs are composed server-side.
R2_PUBLIC_URL=

# The first of the two latches in front of the admin surface. Leave unset (or
# anything other than "true") and every /api/admin route, the /admin pages and
# the /api/auth endpoints all answer 404.
#
# This is a deployment switch, not a statement about the caller: it decides
# whether the surface exists here at all, while ADMIN_EMAILS below decides who
# may use it. Set it on Vercel's Production environment only — preview
# deployments get a new hostname per deploy, which Google refuses as an
# unregistered OAuth redirect URI.
ADMIN_API_ENABLED=

# Google OAuth client for the admin sign-in. Google Cloud Console >
# APIs & Services > Credentials > OAuth client ID > Web application.
# Authorized redirect URI: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs and encrypts the admin session cookie. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Usually leave unset. On Vercel the origin is derived from the forwarded host,
# and `next dev` defaults to http://localhost:3000. Set it only behind a proxy,
# or to pin a deployment to a hostname Google has been told about.
NEXTAUTH_URL=

# Comma-separated Google addresses allowed into /admin — the second latch.
# Checked at sign-in AND on every request after it, so deleting an address here
# revokes access immediately instead of whenever the session expires.
#
# Empty or unset means NOBODY gets in: this list fails closed. Paste each
# address exactly as Google shows it — a Gmail dot or plus alias is a different
# string even though it reaches the same inbox.
ADMIN_EMAILS=
