{
  "name": "cjl-londrina",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-songs.ts",
    "r2:upload": "tsx scripts/upload-songs-r2.ts",
    "r2:cors": "tsx scripts/configure-r2-cors.ts",
    "r2:purge": "tsx scripts/purge-pending-objects.ts",
    "optimize:audio": "node scripts/optimize-audio.js",
    "optimize:images": "node scripts/optimize-images.js",
    "optimize:all": "npm run optimize:images && npm run optimize:audio",
    "build:optimized": "npm run optimize:all && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.7",
    "@vercel/analytics": "^1.5.0",
    "@vercel/functions": "^3.1.4",
    "drizzle-orm": "^0.45.2",
    "fluent-ffmpeg": "^2.1.2",
    "next": "15.1.9",
    "next-auth": "4.24.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-toastify": "^11.0.5",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/youtube": "^0.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "postcss": "^8",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
